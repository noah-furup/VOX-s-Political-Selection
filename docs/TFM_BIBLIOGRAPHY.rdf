    <bib:Article rdf:about="https://www.sciencedirect.com/science/article/pii/S0962629823001312">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:0962-6298"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Ungureanu</foaf:surname>
                        <foaf:givenName>Camil</foaf:givenName>
